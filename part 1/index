<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task 0 — Navigation Bar</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header class="navbar">
    <div class="logo">My Site</div>
    <ul class="nav-links">
      <li><a href="#">Home</a></li>
      <li><a href="#">Work</a></li>
      <li><a href="#">About</a></li>
      <li><a href="#">Contact</a></li>
    </ul>
  </header>

  <main>

    <!-- Task 1 -->
    <section class="card-row">

      <div class="card">
        <img src="../images/job_tracker.png" alt="Project one">
        <div class="card-body">
          <h3>Student Job Tracker</h3>
          <p>The project allows students to keep track of job vacancies and their application status.</p>
          <button>View project</button>
        </div>
      </div>

      <div class="card">
        <img src="../Images/budget.png" alt="Project two">
        <div class="card-body">
          <h3>Budget Tracker</h3>
          <p>Simple monthly budgeting tool with charts and spending categories.</p>
          <button>View project</button>
        </div>
      </div>

      <div class="card">
        <img src="../Images/receipt.png" alt="Project three">
        <div class="card-body">
          <h3>Recipe Box</h3>
          <p>A searchable recipe collection with tags for diet and cook time.</p>
          <button>View project</button>
        </div>
      </div>

    </section>
    <!--Task - 2-->
    <section class="grid-demo">
      <div class="grid-layout">
        <header class="g-header">Header</header>
        <aside class="g-sidebar">Sidebar</aside>
        <section class="g-main">Main Content</section>
        <footer class="g-footer">Footer</footer>
      </div>
    </section>
        <!-- Task - 3 -->
    <section class="gallery-demo">
      <div class="gallery">

        <div class="gallery-item">
          <img src="../Images/liblary.png" alt="Gallery image 1">
          <div class="gallery-caption">Liblary View</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/mountain.png" alt="Gallery image 2">
          <div class="gallery-caption">Mountain View</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/ocean.png" alt="Gallery image 3">
          <div class="gallery-caption">Ocean View</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/volcano.png" alt="Gallery image 4">
          <div class="gallery-caption">Volcano View</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/forest.png" alt="Gallery image 5">
          <div class="gallery-caption">Forest View</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/sky.png" alt="Gallery image 6">
          <div class="gallery-caption">Sky Sunset</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/dog.png" alt="Gallery image 7">
          <div class="gallery-caption">Talant Puppy</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/cat.jpg" alt="Gallery image 8">
          <div class="gallery-caption">Cat</div>
        </div>
        <div class="gallery-item">
          <img src="../Images/bunny.png" alt="Gallery image 9">
          <div class="gallery-caption">Bunny</div>
        </div>

      </div>
    </section>
  </main>

</body>
</html>